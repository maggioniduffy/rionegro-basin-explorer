{
  "name": "basin-explorer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test:e2e": "playwright test",
    "pipeline:download": "tsx pipeline/steps/download.ts",
    "pipeline:inspect": "tsx pipeline/steps/inspect.ts",
    "pipeline:basin": "tsx pipeline/steps/basin.ts",
    "pipeline:rivers": "tsx pipeline/steps/rivers.ts",
    "pipeline:candidates": "tsx pipeline/steps/candidates.ts",
    "pipeline:osm-names": "tsx pipeline/steps/osm-names.ts",
    "pipeline:named": "tsx pipeline/steps/named.ts",
    "pipeline:export": "tsx pipeline/steps/export.ts",
    "pipeline:mask": "tsx pipeline/steps/mask.ts",
    "pipeline:tiles": "tsx pipeline/steps/tiles.ts",
    "predev": "tsx scripts/copy-maplibre-worker.ts",
    "prebuild": "tsx scripts/copy-maplibre-worker.ts",
    "inspect:file": "tsx pipeline/tools/inspect-file.ts",
    "pipeline:lakes": "tsx pipeline/steps/lakes.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "pipeline:subbasins": "tsx pipeline/steps/subbasins.ts",
    "pipeline:ign-gate": "tsx pipeline/steps/ign-gate.ts",
    "pipeline:ign": "tsx pipeline/steps/ign.ts",
    "pipeline:ign-match": "tsx pipeline/steps/ign-match.ts",
    "pipeline:ign-layers": "tsx pipeline/steps/ign-layers.ts",
    "pipeline:localities": "tsx pipeline/steps/localities.ts",
    "perf:zoom": "tsx scripts/perf-zoom.ts",
    "inspect:tiles": "tsx pipeline/tools/tile-stats.ts",
    "atlas:check": "tsx --env-file=.env.local scripts/atlas-check.ts"
  },
  "dependencies": {
    "maplibre-gl": "^6.11.2",
    "mongodb": "^7.7.0",
    "next": "16.3.7",
    "next-intl": "^4.14.8",
    "pmtiles": "^4.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.5.6-r.1",
    "@mapbox/vector-tile": "^3.0.0",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "eslint-config-prettier": "^10.1.8",
    "pbf": "^5.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
