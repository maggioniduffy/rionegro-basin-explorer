# Copy to .env.local and fill in. Never commit real values.

# Server-only (never prefix with NEXT_PUBLIC_)
# The app only reads. On Vercel, MONGODB_URI is a user with Atlas's built-in
# "Only read any database" role (or read@basin-explorer); check it with npm run atlas:check.
MONGODB_URI=mongodb+srv://<read-user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Base database name. Each region has its own database (regions/index.ts regionDbName):
# nqn uses this name as is, other regions append -<id> (basin-explorer-cba, …).
MONGODB_DB=basin-explorer
# npm run seed only (local, never on Vercel): a user with readWrite@basin-explorer.
# Falls back to MONGODB_URI when unset.
MONGODB_SEED_URI=mongodb+srv://<write-user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Public: the browser fetches imagery tiles directly, so these are not secrets.
# Provider: EOxCloudless 2024 (CC BY-NC-SA 4.0, non-commercial; see pipeline/SOURCES.md).
# The attribution is EOX's required text and must stay visible on the map. Leave the URL
# empty to run without imagery (dark background only). Inlined at build time.
NEXT_PUBLIC_IMAGERY_TILE_URL=https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2024_3857/default/g/{z}/{y}/{x}.jpg
NEXT_PUBLIC_IMAGERY_ATTRIBUTION='<a href="https://cloudless.eox.at" target="_blank" rel="noopener">EOxCloudless https://cloudless.eox.at</a> by EOX IT Services GmbH (Contains modified Copernicus Sentinel data 2024), <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener">CC BY-NC-SA 4.0</a>'


# Ask box (/api/ask), server-only. All optional: without an LLM, questions the name match
# can't resolve get "unsupported"; without Upstash, the LLM is never called (fails closed).
# LLM_PROVIDER: groq (default choice) or gemini. Gemini's free tier must not serve EEA/UK/CH
# users (see pipeline/SOURCES.md), so it needs a paid key on a public site.
LLM_PROVIDER=
LLM_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
# Upstash Redis (free tier): per-IP rate limit and shared answer cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random string (≥ 16 chars) mixed into hashed IPs; raw IPs are never stored.
ASK_IP_SALT=

# Public R2 URL of the content bucket (e.g. https://pub-<id>.r2.dev). Set it on Vercel Preview and
# Production only; leave it empty locally to serve public/tiles and public/flow. When set, every
# served region needs a tiles version in content/versions.json or the build fails.
CONTENT_ORIGIN=

# Used only by content publish/pull and the dispatch-only flow-water workflow.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_CONTENT_BUCKET=basin-content
R2_PIPELINE_BUCKET=basin-pipeline
