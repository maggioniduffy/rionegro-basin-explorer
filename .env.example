# Copy to .env.local and fill in. Never commit real values.

# Server-only (never prefix with NEXT_PUBLIC_)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=basin_explorer

# Public: the browser fetches imagery tiles directly, so these are not secrets.
# Provider not chosen yet (PLAN.md open decision; see pipeline/SOURCES.md). Used from Phase 2.
NEXT_PUBLIC_IMAGERY_TILE_URL=
NEXT_PUBLIC_IMAGERY_ATTRIBUTION=
