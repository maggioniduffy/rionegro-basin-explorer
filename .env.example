# Copy to .env.local and fill in. Never commit real values.

# Server-only (never prefix with NEXT_PUBLIC_)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=basin_explorer

# Public: the browser fetches imagery tiles directly, so these are not secrets.
# Provider: EOxCloudless 2024 (CC BY-NC-SA 4.0, non-commercial; see pipeline/SOURCES.md).
# The attribution is EOX's required text and must stay visible on the map. Leave the URL
# empty to run without imagery (dark background only). Inlined at build time.
NEXT_PUBLIC_IMAGERY_TILE_URL=https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2024_3857/default/g/{z}/{y}/{x}.jpg
NEXT_PUBLIC_IMAGERY_ATTRIBUTION='<a href="https://cloudless.eox.at" target="_blank" rel="noopener">EOxCloudless https://cloudless.eox.at</a> by EOX IT Services GmbH (Contains modified Copernicus Sentinel data 2024), <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener">CC BY-NC-SA 4.0</a>'

